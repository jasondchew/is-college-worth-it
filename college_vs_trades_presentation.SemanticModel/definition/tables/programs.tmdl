table programs
	lineageTag: 00822167-740c-45ad-af77-b0540cc9e580

	measure 'CS Crossover Year' =
			
			VAR CSValues =
			    SUMMARIZE(
			        FILTER(earnings_by_year, RELATED(programs[display_name]) = "Computer Science"),
			        earnings_by_year[years_since_start],
			        "CS_Cum", SUM(earnings_by_year[cumulative_earnings_net_of_debt])
			    )
			VAR ElecValues =
			    SUMMARIZE(
			        FILTER(earnings_by_year, RELATED(programs[display_name]) = "Electrician"),
			        earnings_by_year[years_since_start],
			        "Elec_Cum", SUM(earnings_by_year[cumulative_earnings_net_of_debt])
			    )
			VAR Combined = NATURALINNERJOIN(CSValues, ElecValues)
			VAR CrossoverTable = FILTER(Combined, [CS_Cum] >= [Elec_Cum])
			RETURN MINX(CrossoverTable, earnings_by_year[years_since_start])
		formatString: 0
		lineageTag: f6c925e8-abb4-409b-b499-09f8548f8577

	measure 'Finance Crossover Year' =
			
			VAR FinValues =
			    SUMMARIZE(
			        FILTER(earnings_by_year, RELATED(programs[display_name]) = "Finance"),
			        earnings_by_year[years_since_start],
			        "Fin_Cum", SUM(earnings_by_year[cumulative_earnings_net_of_debt])
			    )
			VAR ElecValues =
			    SUMMARIZE(
			        FILTER(earnings_by_year, RELATED(programs[display_name]) = "Electrician"),
			        earnings_by_year[years_since_start],
			        "Elec_Cum", SUM(earnings_by_year[cumulative_earnings_net_of_debt])
			    )
			VAR Combined = NATURALINNERJOIN(FinValues, ElecValues)
			VAR CrossoverTable = FILTER(Combined, [Fin_Cum] >= [Elec_Cum])
			RETURN MINX(CrossoverTable, earnings_by_year[years_since_start])
		formatString: 0
		lineageTag: a3002da1-3bd1-4b37-b05e-81032e6de5b6

	measure 'Median Debt' = SUM(program_costs[total_cost_or_debt])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: ef518c36-813d-4ae8-9bfa-5222f9d6bd86

	measure 'Crossover Year vs Electrician' =
			
			VAR CurrentPath = SELECTEDVALUE(programs[display_name])
			VAR CurrentScenario = SELECTEDVALUE(programs[scenario])
			VAR PathValues =
			    SUMMARIZE(
			        FILTER(
			            ALL(earnings_by_year),
			            RELATED(programs[display_name]) = CurrentPath &&
			            RELATED(programs[scenario]) = CurrentScenario
			        ),
			        earnings_by_year[years_since_start],
			        "Path_Cum", SUM(earnings_by_year[cumulative_earnings_net_of_debt])
			    )
			VAR ElecValues =
			    SUMMARIZE(
			        FILTER(
			            ALL(earnings_by_year),
			            RELATED(programs[display_name]) = "Electrician" &&
			            RELATED(programs[scenario]) = CurrentScenario
			        ),
			        earnings_by_year[years_since_start],
			        "Elec_Cum", SUM(earnings_by_year[cumulative_earnings_net_of_debt])
			    )
			VAR Combined = NATURALINNERJOIN(PathValues, ElecValues)
			VAR CrossoverTable = FILTER(Combined, [Path_Cum] >= [Elec_Cum])
			RETURN
			    IF(CurrentPath = "Electrician", BLANK(), MINX(CrossoverTable, earnings_by_year[years_since_start]))
		formatString: 0
		lineageTag: a36c9c7e-faab-437f-8a61-cd9ba4ef6581

	measure '2020 Satisfaction %' =
			
			VAR CurrentPath = SELECTEDVALUE(programs[display_name])
			VAR OccGroup =
			    SWITCH(
			        CurrentPath,
			        "Computer Science", "CS-related",
			        "Finance", "Finance-related",
			        "Electrician", "Electrician",
			        BLANK()
			    )
			RETURN
			    IF(
			        ISBLANK(OccGroup),
			        BLANK(),
			        CALCULATE(
			            SUM(satisfaction_by_decade[very_satisfied_pct]),
			            satisfaction_by_decade[occupation_group] = OccGroup,
			            satisfaction_by_decade[decade] = "2020"
			        )
			    )
		formatString: 0"%"
		lineageTag: 05bf141c-4fa8-473e-ba69-bdd888e30077

